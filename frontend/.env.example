# Copy to .env (cp .env.example .env). `npm run dev` refuses to start
# without a .env file; `npm run build` requires every variable below
# (on Vercel, set them as project environment variables).

VITE_BACKEND_URL=http://localhost:3001
VITE_MATCHMAKING_URL=ws://localhost:3002

# Optional in dev (left blank, the app runs signed-out with sign-in disabled).
# Supabase → Project Settings → Data API (URL) and API Keys (anon or
# publishable key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
