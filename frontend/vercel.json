{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "vimgym.app" }],
      "destination": "https://www.vimgym.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/s/:slug",
      "destination": "https://vim-racing-server.fly.dev/s/:slug"
    },
    {
      "source": "/s/:slug/og.png",
      "destination": "https://vim-racing-server.fly.dev/s/:slug/og.png"
    },
    {
      "source": "/((?!s/|assets/|sitemap\\.xml|robots\\.txt|favicon|practice|multiplayer|about).*)",
      "destination": "/index.html"
    }
  ]
}
