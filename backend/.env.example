# Copy to .env (cp .env.example .env). The server refuses to start in dev
# without a .env file. In production (NODE_ENV=production) the variables
# marked [prod-required] must be set as Fly secrets.

# [prod-required] Shared with matchmaking/.env; verifies match tokens.
MATCH_TOKEN_SECRET=any-shared-secret-for-dev

# [prod-required] Postgres connection string. Leave blank to run without
# persistence (leaderboard, daily races, stats).
DATABASE_URL=

# [prod-required: at least one] Supabase auth. SUPABASE_URL verifies tokens
# via JWKS and pins the issuer; SUPABASE_JWT_SECRET is the legacy HS256 secret.
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Optional
# PORT=3001
# FRONTEND_URL=https://example.com,https://www.example.com  # extra CORS origins
# HEALTH_METRICS_TOKEN=          # unlocks detailed /health metrics
# LOAD_TEST_SECRET=
# MAX_CONNECTIONS_PER_IP=30
# MAX_TOTAL_SOCKET_CONNECTIONS=2000
# TASK_CACHE_NAVIGATE_COUNT=200
# TASK_CACHE_DELETE_COUNT=200
# TASK_CACHE_YANK_PASTE_COUNT=100
# SHARE_LINK_BASE_URL=https://vimgym.app
# SHARE_CANONICAL_ORIGIN=https://www.vimgym.app

# Never set DAILY_EAGER_CREATE locally: production alone creates the daily race.
