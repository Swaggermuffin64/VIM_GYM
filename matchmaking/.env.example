# Copy to .env (cp .env.example .env). The server refuses to start in dev
# without a .env file. In production (NODE_ENV=production) the variables
# marked [prod-required] must be set as Fly secrets or in fly.toml.

# [prod-required] Shared with backend/.env; signs match tokens.
MATCH_TOKEN_SECRET=any-shared-secret-for-dev

# [prod-required] Game server the matchmaker sends matched players to.
GAME_SERVER_URL=http://localhost:3001

# [prod-required: at least one] Supabase auth for verifying queue tokens.
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Optional
# PORT=3002
# HOST=0.0.0.0
# PLAYERS_PER_MATCH=2
# FRONTEND_URL=https://example.com  # extra CORS origins
# REQUIRE_AUTH=true                 # always on in production
# LOAD_TEST_SECRET=
